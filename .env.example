# ---- Required for launches -------------------------------------------------
# A paid RPC is strongly recommended (Helius, Triton, QuickNode). The public
# endpoint rate-limits hard and will fail under real traffic.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Postgres for the launch registry and the Liquidity Engine ledger
# (Neon, Supabase, Vercel Postgres). Without it, local dev falls back to .data/.
DATABASE_URL=

# 32+ random bytes, e.g. `openssl rand -hex 32`. Encrypts engine vault keys.
# Back it up: without it the vaults cannot be opened.
MASTER_KEY=

# ---- Retro Liquidity Engine ------------------------------------------------
# Wallet that receives the 20% treasury share.
STM_TREASURY_WALLET=
# Base58 secret of the operator wallet that pays network fees for engine
# transactions (claims, transfers, deposits). Keep it lightly funded.
STM_OPERATOR_SECRET=
# off | dry-run | live. dry-run builds and simulates every step and records
# nothing as executed. Start with dry-run.
ENGINE_MODE=dry-run
# Venues allowed to move funds in live mode (comma separated): pump,raydium,meteora
ENGINE_LIVE_VENUES=pump
# Shared secret for the cron endpoint (Vercel sends it as a Bearer token).
CRON_SECRET=

# ---- Meteora (optional) ----------------------------------------------------
# STM's own Dynamic Bonding Curve config (SOL quote). Create it once with
# `npm run meteora:config`. Meteora launches stay disabled until this is set.
METEORA_DBC_CONFIG=

# ---- Metadata (optional) ---------------------------------------------------
# Pinata JWT for IPFS uploads. Without it, metadata goes through pump.fun's
# public IPFS endpoint.
PINATA_JWT=
